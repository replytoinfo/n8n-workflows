    {
      "parameters": {
        "jsCode": "const first = $input.first();\nconst err = first.json.error;\n\nconst message = typeof err === 'string' ? err : (err && err.message) || 'No description';\nconst nodeName = (err && err.node && err.node.name) || $prevNode.name || 'Unknown';\n\nreturn [{ json: { node_name: nodeName, error_message: message } }];"
      },
