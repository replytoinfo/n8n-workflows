      },
      "id": "7c03ade8-e264-4e01-ae46-ff4fde5a03d7",
      "name": "Read Master Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        -640,
        304
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const junkValues = ['45767', '45772', '45718'];\n\nconst recipients = [\n  { key: 'operator-01', startMarker: 'operator-01 start', endMarker: 'operator-01 end', sheetId: 'REPLACE_WITH_SHEET_ID_01', sheetName: 'gid=0' },\n  { key: 'operator-02', startMarker: 'operator-02 start', endMarker: 'operator-02 end', sheetId: 'REPLACE_WITH_SHEET_ID_02', sheetName: 'gid=0' },\n  { key: 'operator-03', startMarker: 'operator-03 start', endMarker: 'operator-03 end', sheetId: 'REPLACE_WITH_SHEET_ID_03', sheetName: 'gid=0' }\n];\n\nreturn recipients.map(r => ({ json: { ...r, junkValues } }));"
      },
      "id": "05f6621c-d30e-4470-955b-63714d87d7bf",
      "name": "Build Recipient Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        304
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "finished-at",
              "name": "finishedAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "57671aee-482f-423f-9cef-f950d90fa2f9",
      "name": "Done",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        112,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "const cfg = $input.first().json;\nconst rows = $('Read Master Sheet').all();\n\nconst norm = (v) => (v === null || v === undefined ? '' : String(v).toLowerCase().trim());\n\nconst start = rows.findIndex(r => norm(r.json.col_1).includes(norm(cfg.startMarker)));\nconst end = rows.findIndex((r, i) => i > start && norm(r.json.col_1).includes(norm(cfg.endMarker)));\n\nif (start === -1 || end === -1) {\n  return [{ json: { _skip: true, key: cfg.key } }];\n}\n\nconst junk = (cfg.junkValues || []).map(norm);\nconst block = rows.slice(start + 1, end);\n\nif (block.length === 0) {\n  return [{ json: { _skip: true, key: cfg.key } }];\n}\n\nreturn block.map(r => {\n  const out = {};\n  for (const field of Object.keys(r.json)) {\n    out[field] = junk.includes(norm(r.json[field])) ? '' : r.json[field];\n  }\n  return { json: out };\n});"
      },
      "id": "82d66f9d-aa71-4b9d-abd4-f0d9887b94b0",
      "name": "Slice Recipient Block",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        128,
        352
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "leftValue": "={{ $json._skip ? \"skip\" : \"ok\" }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "ok"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b86191f3-7bcd-4436-b265-c5b80b13b502",
